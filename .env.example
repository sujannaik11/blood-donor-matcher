# Copy this file to ".env" and fill in your own values. NEVER commit ".env".
# Gmail address used to send/read emails
EMAIL=yourgmail@gmail.com
# Gmail APP PASSWORD (16 letters), not your normal password.
# Google Account > Security > 2-Step Verification > App passwords
APP_PASSWORD=your-16-letter-app-password

# Optional
# Public address donors open from the email link (use your server address if donors use other devices)
APP_URL=http://localhost:8501
# Protects the coordinator tabs. STRONGLY recommended for any public deployment.
ADMIN_PIN=
# Country code used for call / WhatsApp links (91 = India)
COUNTRY_CODE=91
